enum SysRoleActions {
  CREATE
  READ
  UPDATE
  DELETE
}

enum Models {
  user
}

model SysRole {
  id                String           @unique @default(uuid())
  name              String
  description       String
  sysRolePermission RolePermission[]
  users             SysUser[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model RolePermission {
  user_role        SysRole           @relation(fields: [sysUserRoleId], references: [id], onDelete: Restrict)
  user_permissions SystemPermissions @relation(fields: [sysPermissionId], references: [id])
  sysPermissionId  String
  sysUserRoleId    String

  @@id([sysPermissionId, sysUserRoleId])
}

model SystemPermissions {
  id                String           @unique @default(uuid())
  model             Models
  action            SysRoleActions
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  sysRolePermission RolePermission[]
}

model SysUser {
  id            String    @unique @default(uuid())
  name          String
  email         String    @unique
  phone         String?   @default("")
  password      String
  isActive      Boolean
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sysUserRole   SysRole?  @relation(fields: [sysUserRoleId], references: [id], onDelete: Restrict)
  sysUserRoleId String?

  @@map("sys_user")
}
